<%= form_with(model: blog, class: "row g-3 blogs-form") do |form| %>
  <% if blog.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger" role="alert">
        <h5 class="alert-heading">エラーが発生しました</h5>
        <ul class="mb-0">
          <% blog.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-12">
    <%= form.label :title, "タイトル", class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "記事のタイトルを入力してください" %>
  </div>

  <div class="col-12">
    <%= form.label :content, "本文", class: "form-label" %>
    <%= form.rich_text_area :content, class: "form-control", placeholder: "記事の内容を書いてください..." %>
  </div>

  <div class="col-12">
    <div class="form-check">
      <%= form.checkbox :published, class: "form-check-input" %>
      <%= form.label :published, "公開する", class: "form-check-label" %>
    </div>
  </div>

  <div class="col-12">
    <%= form.submit blog.persisted? ? "更新する" : "作成する", class: "btn btn-primary" %>
    <%= link_to "キャンセル", blog.persisted? ? blog_path(blog) : blogs_path, class: "btn btn-secondary ms-2" %>
  </div>
<% end %>
