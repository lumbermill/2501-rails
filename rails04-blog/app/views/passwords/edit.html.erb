<% content_for :title, "新しいパスワードを設定" %>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card shadow">
        <div class="card-body p-4">
          <h2 class="card-title text-center mb-4">新しいパスワードを設定</h2>

          <% if flash[:alert] %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <%= flash[:alert] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <p class="text-muted text-center mb-4">
            新しいパスワードを入力してください。
          </p>

          <%= form_with url: password_path(params[:token]), method: :put, class: "row g-3" do |form| %>
            <div class="col-12">
              <%= form.label :password, "新しいパスワード", class: "form-label" %>
              <%= form.password_field :password,
                                      required: true,
                                      autocomplete: "new-password",
                                      placeholder: "新しいパスワードを入力してください",
                                      maxlength: 72,
                                      class: "form-control" %>
            </div>

            <div class="col-12">
              <%= form.label :password_confirmation, "パスワード（確認）", class: "form-label" %>
              <%= form.password_field :password_confirmation,
                                      required: true,
                                      autocomplete: "new-password",
                                      placeholder: "パスワードを再度入力してください",
                                      maxlength: 72,
                                      class: "form-control" %>
            </div>

            <div class="col-12">
              <%= form.submit "パスワードを更新", class: "btn btn-primary w-100" %>
            </div>
          <% end %>

          <div class="text-center mt-3">
            <%= link_to "ログインに戻る", new_session_path, class: "text-decoration-none" %>
          </div>
        </div>
      </div>

      <div class="text-center mt-3">
        <%= link_to "ブログ一覧に戻る", blogs_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>
