<% content_for :title, "お問い合わせ" %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card shadow">
      <div class="card-body p-4">
        <h2 class="card-title text-center mb-4">お問い合わせ</h2>

        <% if flash[:alert] %>
          <div class="alert alert-danger"><%= flash[:alert] %></div>
        <% end %>

        <%= form_with url: contacts_path, scope: :contact, local: true, class: "row g-3" do |f| %>
          <div class="col-12">
            <%= f.label :name, "お名前（任意）", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", value: params.dig(:contact, :name) %>
          </div>

          <div class="col-12">
            <%= f.label :email, "メールアドレス", class: "form-label" %>
            <%= f.email_field :email, class: "form-control", required: true, value: params.dig(:contact, :email) %>
          </div>

          <div class="col-12">
            <%= f.label :message, "お問い合わせ内容", class: "form-label" %>
            <%= f.text_area :message, class: "form-control", rows: 8, required: true, value: params.dig(:contact, :message) %>
          </div>

          <div class="col-12">
            <%= f.submit "送信", class: "btn btn-primary" %>
            <%= link_to "キャンセル", root_path, class: "btn btn-secondary ms-2" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
